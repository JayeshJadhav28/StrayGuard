# ── Backend ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://strayguard:password@localhost:5432/strayguard
API_KEY_DEVICE=sg_device_key_change_me
JWT_SECRET=sg_jwt_secret_change_me
DZE_LOOKBACK_DAYS=30
FREE_FLOW_SPEED_DEFAULT=60
PORT=3000
